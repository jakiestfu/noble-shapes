{
  "name": "@noble-shapes/node",
  "private": true,
  "version": "0.1.2",
  "description": "Dependency-light Node.js PNG rendering and CLI for noble polyhedra",
  "license": "MIT",
  "homepage": "https://nobleshap.es",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakiestfu/noble-shapes.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/jakiestfu/noble-shapes/issues"
  },
  "keywords": [
    "noble-polyhedra",
    "png",
    "nodejs",
    "cli"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "noble-render": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@noble-shapes/core": "workspace:*",
    "@noble-shapes/render": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
